# LLM-слой (см. AI_LAYER_ARCHITECTURE.md §4, backend/src/main/resources/application.yml).
# Скопируй в .env и заполни перед запуском docker-compose или ./mvnw spring-boot:run.

# stub | claude | openai | gemini | local
# stub — детерминированный шаблонный ответ без сети, включён по умолчанию,
# ничего третьим лицам не отправляет. Любое другое значение включает
# реальный вызов внешнего провайдера через соответствующий LlmAdapter
# (ClaudeAdapter/OpenAiAdapter/GeminiAdapter/LocalLlmAdapter).
LLM_PROVIDER=stub

# Модель провайдера, например claude-sonnet-4-6 (claude) / gpt-4o (openai) /
# gemini-1.5-pro (gemini) / имя модели в Ollama (local).
LLM_MODEL=template-v1.0

# Ключ провайдера. Не нужен для stub и обычно не нужен для local
# (Ollama/локальный сервер без auth).
LLM_API_KEY=

# Только для local — адрес совместимого с OpenAI API сервера,
# например http://localhost:11434/v1.
LLM_BASE_URL=

# Файловый кэш ответов LLM (./llm-cache) — экономит реальные вызовы на
# повторяющихся промптах (например демо golden case).
LLM_CACHE_ENABLED=true

# --- Пример включения реального провайдера (Claude) ---
# LLM_PROVIDER=claude
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=
# LLM_CACHE_ENABLED=true
